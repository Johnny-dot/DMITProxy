exports[`reachable generic guides (regression snapshot) > singBox × linux × en stays stable 1`] = `
{
  "note": "Singbox for Linux works best with the Sing-box format, so switch this page to Sing-box first for the cleanest import path.",
  "recommendedFormat": "singbox",
  "sourceLabel": undefined,
  "sourceUrl": undefined,
  "steps": [
    {
      "ctaLabel": "Open import entry",
      "description": "Sing-box clients usually place imports under Profiles, Configs, or Servers.",
      "helper": "On first launch you may need to allow network or VPN permission before importing.",
      "screenshot": undefined,
      "title": "Open the profile import entry in Singbox for Linux",
      "tone": "launch",
      "visualItems": [
        "Profiles",
        "Configs",
        "Servers",
      ],
      "visualLabel": "Profiles / Servers",
    },
    {
      "ctaLabel": "Import profile",
      "description": "Choose Sing-box on this page first, then import by URL or clipboard inside the client.",
      "helper": "If the client talks about Profiles or JSON, that is usually the sing-box-native import path.",
      "screenshot": undefined,
      "title": "Switch to the Sing-box format before importing",
      "tone": "import",
      "visualItems": [
        "Sing-box format",
        "URL / Clipboard",
        "Save",
      ],
      "visualLabel": "Import Sing-box profile",
    },
    {
      "ctaLabel": "Connect",
      "description": "Make sure nodes, DNS, and rule resources have loaded before you hit connect.",
      "helper": "These clients expose more low-level options, so avoid changing unfamiliar toggles until the import works.",
      "screenshot": undefined,
      "title": "Save, switch to the imported profile, then connect",
      "tone": "connect",
      "visualItems": [
        "Select imported profile",
        "Refresh subscription",
        "Allow system proxy",
      ],
      "visualLabel": "Connect",
    },
  ],
}
`;

